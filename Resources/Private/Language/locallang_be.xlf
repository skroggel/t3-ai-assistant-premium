	<file source-language="en" datatype="plaintext" original="messages" date="2026-06-13T00:00:00Z" product-name="ai_assistant_premium">
		<body>
			<trans-unit id="plugin.tx_aiassistantpremium_search.title">
				<source>AI search enhancer</source>
			</trans-unit>
			<trans-unit id="plugin.tx_aiassistantpremium_search.description">
				<source>Adds optional AI query optimization to an existing search-engine form.</source>
			</trans-unit>
			<trans-unit id="plugin.tx_aiassistantpremium_searchsummary.title">
				<source>AI search summary</source>
			</trans-unit>
		<trans-unit id="plugin.tx_aiassistantpremium_searchsummary.description">
				<source>Summarizes the structured results emitted by the search result template.</source>
			</trans-unit>
			<trans-unit id="settings.category.aiAssistantPremium.label">
				<source>AI Assistant Premium</source>
			</trans-unit>
			<trans-unit id="settings.category.aiAssistantPremium.description">
				<source>Configuration for Premium search integration and frontend request security.</source>
			</trans-unit>
			<trans-unit id="settings.useClassicalSearch.label">
				<source>Use classical search integration</source>
			</trans-unit>
			<trans-unit id="settings.useClassicalSearch.description">
				<source>Loads the classic Fluid and KeSearch template overrides. Disable this for a JavaScript/Vue-based search rendering.</source>
			</trans-unit>
			<trans-unit id="settings.allowedAssistantProfiles.label">
				<source>Allowed Assistant profiles</source>
			</trans-unit>
			<trans-unit id="settings.allowedAssistantProfiles.description">
				<source>Assistant profile UIDs allowed for public JSON frontend requests.</source>
			</trans-unit>
			<trans-unit id="settings.requestTokenTtl.label">
				<source>Frontend request token lifetime</source>
			</trans-unit>
			<trans-unit id="settings.requestTokenTtl.description">
				<source>Lifetime of signed frontend request tokens in seconds.</source>
			</trans-unit>
			<trans-unit id="configuration.pdf.linkToMatchedPage.label">
				<source>PDF result links</source>
			</trans-unit>
			<trans-unit id="configuration.pdf.linkToMatchedPage.description">
				<source>Controls whether PDF results link to the complete document or directly to the matched page. Force a full reindex after changing this setting.</source>
			</trans-unit>
			<trans-unit id="configuration.pdf.linkToMatchedPage.option.completePdf">
				<source>Link to the complete PDF</source>
			</trans-unit>
			<trans-unit id="configuration.pdf.linkToMatchedPage.option.matchedPage">
				<source>Link directly to the matched page</source>
			</trans-unit>
		</body>
