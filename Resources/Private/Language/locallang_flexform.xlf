<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
	<file source-language="en" datatype="plaintext" original="messages" date="2026-06-13T00:00:00Z" product-name="ai_assistant_premium">
		<body>
			<trans-unit id="flexform.ke_search.sheet.general">
				<source>AI search enhancement</source>
			</trans-unit>
			<trans-unit id="flexform.search.optimizer_profile">
				<source>Query optimizer profile (optional)</source>
			</trans-unit>
			<trans-unit id="flexform.search.integration">
				<source>Search integration</source>
			</trans-unit>
			<trans-unit id="flexform.search.form_selector">
				<source>Search form CSS selector</source>
			</trans-unit>
			<trans-unit id="flexform.search.form_selector.description">
				<source>Identifies the native search-engine form that should receive the optional AI query optimization metadata.</source>
			</trans-unit>
			<trans-unit id="flexform.search.summary_profile">
				<source>Search summary profile</source>
			</trans-unit>
			<trans-unit id="flexform.search.include_default_styles">
				<source>Include default chat styles</source>
			</trans-unit>
            <trans-unit id="flexform.search.include_default_styles.description">
                <source>Includes the built-in chat component CSS. Disable this when the host project provides its own styles.</source>
            </trans-unit>
            <trans-unit id="flexform.search.show_without_results">
                <source>Show summary without search results</source>
            </trans-unit>
            <trans-unit id="flexform.search.show_without_results.description">
                <source>Runs the AI summary even when the search returns no results.</source>
            </trans-unit>
            <trans-unit id="flexform.search.number_of_typing_dots">
                <source>Number of typing dots</source>
            </trans-unit>
            <trans-unit id="flexform.search.number_of_typing_dots.description">
                <source>Number of dots shown while the assistant is generating a response.</source>
            </trans-unit>
            <trans-unit id="flexform.search.sheet.advanced"><source>Advanced</source></trans-unit>
            <trans-unit id="flexform.search.render_lag_characters"><source>Render lag (characters)</source></trans-unit>
            <trans-unit id="flexform.search.render_lag_characters.description"><source>Number of streamed characters kept ahead of the visual renderer.</source></trans-unit>
            <trans-unit id="flexform.search.render_chunk_characters"><source>Render chunk size (characters)</source></trans-unit>
            <trans-unit id="flexform.search.render_chunk_characters.description"><source>Number of characters rendered per visual catch-up step.</source></trans-unit>
            <trans-unit id="flexform.search.initial_message_delay"><source>Initial message delay (milliseconds)</source></trans-unit>
            <trans-unit id="flexform.search.response_message_delay"><source>Response message delay (milliseconds)</source></trans-unit>
            <trans-unit id="flexform.search.loading_messages"><source>Loading messages</source></trans-unit>
            <trans-unit id="flexform.search.loading_messages.description"><source>JSON array of messages shown while the assistant is preparing the response. Example: [&quot;I am searching ...&quot;, &quot;I am preparing the answer ...&quot;]</source></trans-unit>
            <trans-unit id="flexform.search.loading_messages_timeout"><source>Loading message interval (milliseconds)</source></trans-unit>
            <trans-unit id="flexform.search.loading_messages_timeout.description"><source>Time between rotating loading messages in milliseconds. Messages rotate only while the assistant is generating.</source></trans-unit>
            <trans-unit id="flexform.search.loading_html"><source>Loading HTML</source></trans-unit>
            <trans-unit id="flexform.search.loading_html.description"><source>Optional HTML shown next to the loading messages while the assistant is preparing the response. Example: &lt;span class=&quot;spinner&quot;&gt;&lt;/span&gt;</source></trans-unit>
            <trans-unit id="flexform.search.stream_response"><source>Stream response</source></trans-unit>
            <trans-unit id="flexform.search.stream_response.description"><source>Stream the answer while it is generated. Disable this to use the complete JSON response.</source></trans-unit>
		</body>
	</file>
