<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="de" datatype="plaintext" original="messages" date="2026-01-01T00:00:00Z" product-name="ai_assistant_premium">
        <body>
            <trans-unit id="flexform.ke_search.sheet.general">
                <source>AI search enhancement</source>
                <target>KI-Sucherweiterung</target>
            </trans-unit>
            <trans-unit id="flexform.search.optimizer_profile">
                <source>Query optimizer profile (optional)</source>
                <target>Profil für die Suchanfragenoptimierung (optional)</target>
            </trans-unit>
            <trans-unit id="flexform.search.integration">
                <source>Search integration</source>
                <target>Suchintegration</target>
            </trans-unit>
            <trans-unit id="flexform.search.form_selector">
                <source>Search form CSS selector</source>
                <target>CSS-Selektor des Suchformulars</target>
            </trans-unit>
            <trans-unit id="flexform.search.form_selector.description">
                <source>Identifies the native search-engine form that should receive the optional AI query optimization metadata.</source>
                <target>Identifiziert das native Suchformular, das optionale Metadaten zur KI-gestützten Suchanfragenoptimierung erhalten soll.</target>
            </trans-unit>
            <trans-unit id="flexform.search.summary_profile">
                <source>Search summary profile</source>
                <target>Profil für die Suchzusammenfassung</target>
            </trans-unit>
            <trans-unit id="flexform.search.include_default_styles">
                <source>Include default chat styles</source>
                <target>Standard-Chat-Styles einbinden</target>
            </trans-unit>
            <trans-unit id="flexform.search.include_default_styles.description">
                <source>Includes the built-in chat component CSS. Disable this when the host project provides its own styles.</source>
                <target>Bindet das integrierte CSS der Chat-Komponenten ein. Deaktivieren, wenn das Host-Projekt eigene Styles bereitstellt.</target>
            </trans-unit>
            <trans-unit id="flexform.search.show_without_results">
                <source>Show summary without search results</source>
                <target>Zusammenfassung auch ohne Suchergebnisse anzeigen</target>
            </trans-unit>
            <trans-unit id="flexform.search.show_without_results.description">
                <source>Runs the AI summary even when the search returns no results.</source>
                <target>Führt die KI-Zusammenfassung auch aus, wenn die Suche keine Ergebnisse liefert.</target>
            </trans-unit>
            <trans-unit id="flexform.search.number_of_typing_dots">
                <source>Number of typing dots</source>
                <target>Anzahl der Typing-Dots</target>
            </trans-unit>
            <trans-unit id="flexform.search.number_of_typing_dots.description">
                <source>Number of dots shown while the assistant is generating a response.</source>
                <target>Anzahl der Punkte, die während der Antwortgenerierung angezeigt werden.</target>
            </trans-unit>
            <trans-unit id="flexform.search.sheet.advanced">
                <source>Advanced</source>
                <target>Erweitert</target>
            </trans-unit>
            <trans-unit id="flexform.search.render_lag_characters">
                <source>Render lag (characters)</source>
                <target>Render-Verzögerung (Zeichen)</target>
            </trans-unit>
            <trans-unit id="flexform.search.render_lag_characters.description">
                <source>Number of streamed characters kept ahead of the visual renderer.</source>
                <target>Anzahl der Zeichen, um die die Darstellung dem Stream voraus bleibt.</target>
            </trans-unit>
            <trans-unit id="flexform.search.render_chunk_characters">
                <source>Render chunk size (characters)</source>
                <target>Render-Schrittgröße (Zeichen)</target>
            </trans-unit>
            <trans-unit id="flexform.search.render_chunk_characters.description">
                <source>Number of characters rendered per visual catch-up step.</source>
                <target>Anzahl der Zeichen pro sichtbarem Aufholschritt.</target>
            </trans-unit>
            <trans-unit id="flexform.search.initial_message_delay">
                <source>Initial message delay (milliseconds)</source>
                <target>Verzögerung der Anfangsnachricht (Millisekunden)</target>
            </trans-unit>
            <trans-unit id="flexform.search.response_message_delay">
                <source>Response message delay (milliseconds)</source>
                <target>Verzögerung der Antwort (Millisekunden)</target>
            </trans-unit>
            <trans-unit id="flexform.search.loading_messages">
                <source>Loading messages</source>
                <target>Ladenachrichten</target>
            </trans-unit>
            <trans-unit id="flexform.search.loading_messages.description">
                <source>JSON array of messages shown while the assistant is preparing the response. Example: [&quot;I am searching ...&quot;, &quot;I am preparing the answer ...&quot;]</source>
                <target>JSON-Array mit Nachrichten, die während der Antwortvorbereitung angezeigt werden. Beispiel: [&quot;Ich suche passende Informationen ...&quot;, &quot;Ich bereite die Antwort vor ...&quot;]</target>
            </trans-unit>
            <trans-unit id="flexform.search.loading_messages_timeout">
                <source>Loading message interval (milliseconds)</source>
                <target>Intervall der Ladenachrichten (Millisekunden)</target>
            </trans-unit>
            <trans-unit id="flexform.search.loading_messages_timeout.description">
                <source>Time between rotating loading messages in milliseconds. Messages rotate only while the assistant is generating.</source>
                <target>Zeit zwischen wechselnden Ladenachrichten in Millisekunden. Die Nachrichten wechseln nur während der Antwortgenerierung.</target>
            </trans-unit>
            <trans-unit id="flexform.search.loading_html">
                <source>Loading HTML</source>
                <target>Lade-HTML</target>
            </trans-unit>
            <trans-unit id="flexform.search.loading_html.description">
                <source>Optional HTML shown next to the loading messages while the assistant is preparing the response. Example: &lt;span class=&quot;spinner&quot;&gt;&lt;/span&gt;</source>
                <target>Optionales HTML, das während der Antwortvorbereitung neben den Ladenachrichten angezeigt wird. Beispiel: &lt;span class=&quot;spinner&quot;&gt;&lt;/span&gt;</target>
            </trans-unit>
            <trans-unit id="flexform.search.stream_response">
                <source>Stream response</source>
                <target>Antwort streamen</target>
            </trans-unit>
            <trans-unit id="flexform.search.stream_response.description">
                <source>Stream the answer while it is generated. Disable this to use the complete JSON response.</source>
                <target>Die Antwort während der Generierung streamen. Deaktivieren, um die vollständige JSON-Antwort zu verwenden.</target>
            </trans-unit>
        </body>
    </file>
</xliff>
